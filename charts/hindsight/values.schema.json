{
   "$schema": "http://json-schema.org/draft-07/schema#",
   "type": "object",
   "properties": {
      "hindsight": {
         "type": "object",
         "properties": {
            "version": {
               "type": "string",
               "description": "Version of Qdrant chart to use"
            },
            "env": {
               "type": "object",
               "additionalProperties": true,
               "description": "Environment variables to configure Hindsight"
            },
            "secrets": {
               "type": "object",
               "additionalProperties": true,
               "description": "Sensitive environment variables to configure Hindsight"
            },
            "llm": {
               "type": "object",
               "properties": {
                  "provider": {
                     "type": "string",
                     "enum": ["openai", "openai-responses", "groq", "ollama", "gemini", "anthropic", "lmstudio", "vertexai", "minimax", "deepseek", "zai", "atlas", "meta", "volcano", "openai-codex", "claude-code", "cursor", "github-copilot", "openrouter"],
                     "description": "Provider for the LLM API"
                  },
                  "baseUrl": {
                     "type": ["string", "null"],
                     "description": "Base URL for the LLM API"
                  },
                  "apiKey": {
                     "type": ["string", "null"],
                     "description": "API key for the LLM API"
                  },
                  "model": {
                     "type": ["string", "null"],
                     "description": "Model to use for the LLM API"
                  },
                  "maxConcurrent": {
                     "type": "integer",
                     "description": "Maximum number of concurrent requests to the LLM API"
                  }
               }
            },
            "embedding": {
               "type": "object",
               "properties": {
                  "provider": {
                     "type": "string",
                     "enum": ["local", "onnx", "tei", "openai", "cohere", "google", "openrouter", "zeroentropy", "litellm", "litellm-sdk"],
                     "description": "Provider for the embedding API"
                  },
                  "baseUrl": {
                     "type": ["string", "null"],
                     "description": "Base URL for the embedding API"
                  },
                  "apiKey": {
                     "type": ["string", "null"],
                     "description": "API key for the embedding API"
                  },
                  "model": {
                     "type": ["string", "null"],
                     "description": "Model to use for the embedding API"
                  }
               }
            },
            "autoscaling": {
               "type": "object",
               "properties": {
                  "enabled": {
                     "type": "boolean",
                     "description": "Enable autoscaling for hindsight deployment"
                  },
                  "minReplicas": {
                     "type": "integer",
                     "description": "Minimum replicas to maintain"
                  },
                  "maxReplicas": {
                     "type": "integer",
                     "description": "Max replicas to scale out to"
                  },
                  "targetCPUUtilizationPercentage": {
                     "type": "integer",
                     "description": "CPU utilisation percentage to control scaling"
                  },
                  "targetMemoryUtilizationPercentage": {
                     "type": "integer",
                     "description": "Memory utilisation percentage to control scaling"
                  }
               }
            }  
         }
      },
       "postgresql": {
         "type": "object",
         "properties": {
            "username": {
               "type": ["string", "null"],
               "description": "Built-in Postgres admin username"
            },
            "database": {
               "type": ["string", "null"],
               "description": "Built-in Postgres default database name"
            },
            "password": {
               "type": ["string", "null"],
               "description": "Built-in Postgres password to use"
            },
            "enabled": {
               "type": "boolean",
               "description": "Whether to deploy a built-in postres"
            },
            "externalConnectionString": {
               "type": ["string", "null"],
               "description": "External PostgreSQL connection string; Only used if postgresql.enabled is false"
            }
         },
         "required": []
      },
      "ingress": {
         "type": "object",
         "properties": {
            "enabled": {
               "type": "boolean",
               "description": "Enable ingress for the vLLM service"
            },
            "subdomain": {
               "type": "string",
               "description": "Subdomain for the ingress"
            }
         }
      },
      "system": {
         "properties": {
            "envFromSecrets": {
               "type": "object",
               "description": "Dictionary mapping environment variable names to secret names"
            },
            "priorityClassName": {
                "type": "string",
                "description": "PriorityClassName to use for the deployment"
            },
            "jobId": {
                "type": ["string", "null"],
                "description": "Job ID to label spawned objects."
            },
            "nodeSelectors": {
               "type": [
                  "object",
                  "null"
               ],
               "description": "target specific devices. Expected format -> key: value pairs, where 'value' is a list of elements"
            },
            "nodeSelectorsOps": {
               "type": "string",
               "enum": ["OR", "AND"],
               "description": "Logical operation to use to apply to nodeSelectors. Accepted values: 'OR', 'AND'"
            },
            "nodeAffinityPreferenceKey": {
               "type": ["null", "string"],
               "description": "Node affinity preference key to use for the deployment"
            }
            
         }
      },
      "resources": {
         "type": "object",
         "properties": {
            "replicas": {
               "type": "integer",
               "description": "Number of replicas to run"
            },
            "workerGpuMemory": {
               "type": ["integer", "null"],
               "description": "Worker GPU memory limit in GB (multiplied by 1000 for nvidia.com/gpumem resource)"
            },
            "workingMemory": {
               "description": "Temporary storage to use to cache model weights (in GB), should be big enough to hold the model weights. All workers should have enough free disk to accommodate the weights.",
               "type": "integer"
            },
            "workers": {
               "description": "Number of workers, corresponding to the number of nodes (or machines) that will be used to deploy the model",
               "type": "integer"
            },
            "backend": {
               "description": "Use 'cuda' (nvidia cards), 'rocm' (AMD cards) or cpu-only backend",
               "type": "string",
               "enum": ["cuda", "cpu", "rocm"]
            },
            "memory": {
               "description": "Memory to be used per single worker (final one = memory * workers). Workers should have these many GB of memory available.",
               "type": "integer"
            },
            "cpus": {
               "description": "CPUs to be used per single worker (final one = cpus * workers). Workers should have these many CPUs available.",
               "type": "integer"
            },
            "gpus": {
               "description": "GPUs to be used per single worker (final one = gpus * workers). Workers should have these many GPUs available.",
               "type": "integer"
            }
         }
      }
   },
   "required": []
}